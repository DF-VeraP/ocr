# =======================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN (DOKPLOY / VPS)
# =======================================================

# Dominio público asignado al frontend en Dokploy (ej: https://ocr.midominio.com)
CLIENT_URL=https://tu-dominio-sena.com

# Puerto público que expone el frontend en el host VPS (Puerto 5050 libre, evitando conflicto con Nginx/Traefik en el 80)
PORT=5050

# Credenciales de Base de Datos PostgreSQL
POSTGRES_USER=sena_admin
POSTGRES_PASSWORD=CambiarPorPasswordMuySeguro123*
POSTGRES_DB=ocr_cedulas

# Seguridad JWT (Generar cadenas aleatorias largas para producción)
JWT_SECRET=generar_cadena_secreta_aleatoria_muy_larga_de_minimo_64_caracteres_jwt_access
JWT_REFRESH_SECRET=generar_cadena_secreta_aleatoria_muy_larga_de_minimo_64_caracteres_jwt_refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cuenta del Administrador Predeterminado Inicial
ADMIN_EMAIL=admin@sena.edu.co

# Notificaciones por Correo (SMTP / Gmail u otro servidor)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones.sena@gmail.com
SMTP_PASS=tu_password_de_aplicacion_gmail
